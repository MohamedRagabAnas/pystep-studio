# Copy this file to .env and add your own key.
#
# Good free/limited starting options:
#
# OpenRouter, if the site/API works on your network:
#   AI_PROVIDER=openai-compatible
#   AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
#   AI_MODEL=openrouter/free
#
# Groq also uses an OpenAI-compatible chat completions API:
#   AI_PROVIDER=openai-compatible
#   AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions
#   AI_MODEL=openai/gpt-oss-20b
#
# Google Gemini uses a different API shape:
#   AI_PROVIDER=gemini
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
#   AI_MODEL=gemini-2.0-flash

AI_API_KEY=replace_with_your_key
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
AI_MODEL=openrouter/free
AI_APP_TITLE=PyStep Studio
AI_APP_URL=http://127.0.0.1:8000/
PORT=8000
